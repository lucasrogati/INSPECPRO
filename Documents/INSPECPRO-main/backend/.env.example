PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inspecpro

JWT_SECRET=troque_esta_chave_por_uma_string_segura_e_aleatoria
JWT_EXPIRES_IN=8h

# Segurança
# Origens do frontend permitidas pelo CORS (separe várias por vírgula)
CORS_ORIGIN=http://localhost:5173
# Limite de tentativas de login malsucedidas por IP, dentro da janela (minutos)
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MIN=15
# Atrás de proxy reverso? Informe o nº de proxies (ex.: 1). Deixe em branco se não houver.
# TRUST_PROXY=1
